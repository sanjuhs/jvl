{
  "name": "lvl-language",
  "displayName": "LVL — Legal Verifiable Language",
  "description": "Syntax highlighting for LVL (.lvl) legal programs.",
  "version": "0.1.0",
  "publisher": "lvl",
  "license": "MIT",
  "repository": { "type": "git", "url": "https://github.com/sanjuhs/lvl" },
  "engines": { "vscode": "^1.60.0" },
  "categories": ["Programming Languages"],
  "contributes": {
    "languages": [
      {
        "id": "lvl",
        "aliases": ["LVL", "lvl"],
        "extensions": [".lvl"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "lvl",
        "scopeName": "source.lvl",
        "path": "./syntaxes/lvl.tmLanguage.json"
      }
    ]
  }
}
